# Backend Environment Variables Template
# Copy this file to .env and configure as needed

# Database connection (default: SQLite backend/habitflow.db)
# DATABASE_URL=sqlite:///./habitflow.db

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://trackyourhabitss.netlify.app,http://localhost:5173,http://localhost:5174

# JWT Security
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
